--==================================================
-- SERVICES
--==================================================
local workspace = game:GetService("Workspace")
local RS = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local world = require(
    RS.Shared.Universe.ECS.world
)

local components = require(
    RS.Shared.Universe.ECS.components
)

local replicator = require(
    RS.Client.Universe.Replication.clientReplicator
)

local Store = RS.Shared.Universe.Network.RemoteEvent.Store
local Actionable = RS.Shared.Universe.Network.RemoteEvent.Actionable
local EventMelee = RS.Shared.Universe.Network.RemoteEvent.SwingMelee
local Pickup = RS.Shared.Universe.Network.RemoteEvent.Pickup
--==================================================
-- VARIABLES
--==================================================
_G.FastMelee = false
_G.AutoFarmBond = false
_G.InfiniteItem = false
_G.BringRandom = false

local SelectedItem = nil
--==================================================
-- FUNCTIONS
--==================================================

local function GetBonds()
    local bonds = {}

    for entity, objectId in world:query(components.ObjectId) do
        if tostring(objectId):lower() == "bond" then
            local serverId = replicator.client_ids[entity]

            if serverId then
                bonds[serverId] = true
            end
        end
    end

    return bonds
end

local function RunBondFarm()
    local bonds = GetBonds()
    for serverId in pairs(bonds) do
        Store:FireServer(serverId)
        task.wait(0.1)
        Store:FireServer(nil)
        task.wait()
        Actionable:FireServer(serverId)
    end
end

local function StartAutoFarmBond()
    task.spawn(function()
        local count = 0
        while _G.AutoFarmBond do
            local bonds = GetBonds()
            for serverId in pairs(bonds) do
                if not _G.AutoFarmBond then
                    break
                end
                count += 1
                Store:FireServer(serverId)
                task.wait(0.1)
                Store:FireServer(nil)
                task.wait()
          Actionable:FireServer(serverId)
            end
            if count == 0 then
                break
            end
            task.wait(0.2)
        end
        _G.AutoFarmBond = false
    end)
end

local function FastMelee()
  task.spawn(function()
        while _G.FastMelee do
            task.wait(0.1)

            local Character = LocalPlayer.Character
            local Tool = Character and Character:FindFirstChildOfClass("Tool")

            if Tool then
                EventMelee:FireServer(
                    Tool,
                    1787399017,
                    Vector3.new(
                        0.750,
                        -0.350,
                        -0.590
                    )
                )
            end
        end
    end)
end

local function PickupSelectedItem()
    task.spawn(function()
        while _G.InfiniteItem do
            local ObjectModel = workspace:FindFirstChild("ObjectModels")

            if ObjectModel and SelectedItem then
                for _, Model in ipairs(ObjectModel:GetChildren()) do
                    if not _G.InfiniteItem then
                        break
                    end

                    if Model:IsA("Model") and Model.Name == SelectedItem then
                        local serverEntity = Model:GetAttribute("serverEntity")

                        if serverEntity then
                            Pickup:FireServer(serverEntity)
                        end
                    end
                end
            end

            task.wait()
        end
    end)
end

local function GetObjectModels()
    local ObjectModel = workspace.ObjectModels
    local models = {}
    local seen = {}

    for _, Model in ipairs(ObjectModel:GetChildren()) do
        if Model:IsA("Model") and not seen[Model.Name] then
            seen[Model.Name] = true
            table.insert(models, Model.Name)
        end
    end

    table.sort(models)

    return models
end

local function BringRandom()
    task.spawn(function()
        local max = 4000
        for i = 1, max do
            if not _G.BringRandom then
                break
            end
            Store:FireServer(i)
            task.wait()
            Store:FireServer(nil)
        end
    end)
end

